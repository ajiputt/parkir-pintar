      "id": 11,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "topk(10, sum by (grpc_service, grpc_method) (rate(grpc_requests_total{namespace=\"parkir\"}[1m])))",
          "legendFormat": "{{grpc_service}}/{{grpc_method}}",
          "refId": "A"
        }
      ],
      "title": "Top 10 gRPC Methods",
