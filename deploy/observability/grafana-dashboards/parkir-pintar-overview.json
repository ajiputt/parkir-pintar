        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(grpc_request_duration_seconds_bucket{namespace=\"parkir\"}[5m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(grpc_request_duration_seconds_bucket{namespace=\"parkir\"}[5m])) by (le))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(grpc_request_duration_seconds_bucket{namespace=\"parkir\"}[5m])) by (le))", "legendFormat": "p99", "refId": "C" }
      ],
      "title": "gRPC Latency Percentiles",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "gRPC P95 latency per method. Slow methods = candidates for optimization.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5,
            "lineInterpolation": "linear",
