    {
      "name": "Payment Service",
      "description": "Endpoints di port 9193 (kalau payment service running).",
      "item": [
        {
          "name": "Healthz (Payment)",
          "request": {
            "method": "GET",
            "url": "{{paymentDirectUrl}}/healthz"
          }
        },
        {
          "name": "Create Payment (QRIS)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('paymentIdemKey', pm.variables.replaceIn('{{$guid}}'));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('paymentId', json.id);",
                  "if (json.qr_string) console.log('QR String length:', json.qr_string.length);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{paymentIdemKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoice_id\": \"{{invoiceId}}\"\n}"
            },
            "url": "{{baseUrl}}/v1/payments",
            "description": "Generate QRIS payment via Midtrans (sandbox atau mock).\n\nResponse 201:\n```json\n{\n  \"id\": \"...\",\n  \"invoice_id\": \"...\",\n  \"qr_string\": \"00020101...\",\n  \"status\": \"PENDING\",\n  \"amount_idr\": 30000,\n  \"expires_at\": \"...\"\n}\n```"
          }
        },
        {
          "name": "Get Payment by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/payments/{{paymentId}}"
          }
        },
        {
          "name": "Simulate Midtrans Webhook (settlement)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate signature key SHA512 sesuai algoritma Midtrans:",
                  "// signature = sha512(order_id + status_code + gross_amount + server_key)",
                  "// Karena Postman tidak punya SHA512 native, pakai library di prerequest",
                  "// Atau set manual via env var.",
                  "//",
                  "// Untuk demo cepat: pakai script `simulate-midtrans-webhook.sh` di repo,",
