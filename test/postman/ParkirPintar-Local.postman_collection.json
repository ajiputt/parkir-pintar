    {
      "name": "Availability & Spots",
      "description": "Query availability per floor & vehicle type.",
      "item": [
        {
          "name": "Get Availability",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "availability"
              ]
            },
            "description": "Snapshot availability per floor.\n\nResponse:\n```json\n{\n  \"parking_area_id\": \"...\",\n  \"parking_area_name\": \"ParkirPintar Main\",\n  \"total_car_available\": 150,\n  \"total_motor_available\": 250,\n  \"floors\": [\n    {\n      \"level\": 1,\n      \"car_available\": 30,\n      \"car_capacity\": 30,\n      \"motor_available\": 50,\n      \"motor_capacity\": 50\n    }\n    // ...\n  ]\n}\n```"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has 5 floors', () => pm.expect(json.floors).to.have.lengthOf(5));",
                  "pm.test('Total CAR = 150', () => pm.expect(json.total_car_available).to.be.at.most(150));",
                  "pm.test('Total MOTOR = 250', () => pm.expect(json.total_motor_available).to.be.at.most(250));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Available Spots",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/spots?vehicle_type=CAR&status=AVAILABLE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "spots"
              ],
              "query": [
                {
                  "key": "vehicle_type",
                  "value": "CAR",
                  "description": "CAR | MOTOR (optional)"
                },
                {
                  "key": "status",
                  "value": "AVAILABLE",
                  "description": "AVAILABLE | HELD | OCCUPIED | OUT_OF_SERVICE (optional, default AVAILABLE)"
                },
                {
                  "key": "floor_level",
                  "value": "",
                  "disabled": true,
                  "description": "1-5 (optional — kalau set, response cuma 1 floor)"
                }
              ]
            },
            "description": "List spot **grouped per lantai** untuk USER-assigned booking flow.\n\nDriver pakai response.floors[] untuk render UI selector per lantai. Pilih spot, lalu kirim Create Reservation dengan `mode=USER` + `spot_id`.\n\nResponse shape:\n```\n{\n  \"floors\": [\n    { \"level\": 1, \"capacity\": 30, \"available\": 28, \"spots\": [...] },\n    { \"level\": 2, \"capacity\": 30, \"available\": 30, \"spots\": [...] }\n  ],\n  \"total\": 150\n}\n```\n\nNo pagination — dataset kecil (max 400 spot ParkirPintar)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Reservation Lifecycle",
      "description": "Happy path: Create → CheckIn → CheckOut. Pakai berurutan supaya {{reservationId}} ter-populate.",
      "item": [
        {
          "name": "Create Reservation (System-assigned)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate fresh idempotency key tiap request",
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));",
                  "// Set start_at = now + 1 menit, end_at = now + 2 jam",
                  "const now = Date.now();",
                  "pm.collectionVariables.set('startAt', new Date(now + 60_000).toISOString());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 2xx', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const json = pm.response.json();",
                  "pm.test('Has id', () => pm.expect(json.id).to.be.a('string'));",
                  "pm.test('State = CONFIRMED', () => pm.expect(json.state).to.eql('CONFIRMED'));",
                  "pm.test('Booking fee = 5000 IDR', () => pm.expect(json.booking_fee_idr).to.eql(5000));",
                  "pm.test('Has spot_code (e.g. F1-C-001)', () => pm.expect(json.spot_code).to.match(/^F\\d-[CM]-\\d{3}$/));",
                  "// Save id ke collection variable",
                  "pm.collectionVariables.set('reservationId', json.id);",
                  "pm.collectionVariables.set('spotId', json.spot_id);",
                  "console.log('Reservation created:', json.id, '@', json.spot_code);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driver_id\": \"driver-postman-1\",\n  \"plate_no\": \"B 1234 ABC\",\n  \"vehicle_type\": \"CAR\",\n  \"mode\": \"SYSTEM\",\n  \"payment_mode\": \"AUTO\",\n  \"start_at\": \"{{startAt}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "reservations"
              ]
            },
            "description": "Create reservation dengan SYSTEM mode (sistem auto-pick spot).\n\nHeader wajib:\n- `Idempotency-Key`: UUID v4. Otomatis ter-generate via pre-request script.\n\nResponse 201:\n```json\n{\n  \"id\": \"...\",\n  \"driver_id\": \"...\",\n  \"spot_id\": \"...\",\n  \"spot_code\": \"F1-C-001\",\n  \"floor_level\": 1,\n  \"state\": \"CONFIRMED\",\n  \"start_at\": \"...\",\n  \"end_at\": \"...\",\n  \"expires_at\": \"...\",\n  \"booking_fee_idr\": 5000\n}\n```"
          }
        },
        {
          "name": "Create Reservation (User-selected spot)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));",
                  "const now = Date.now();",
                  "pm.collectionVariables.set('startAt', new Date(now + 60_000).toISOString());"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driver_id\": \"driver-postman-2\",\n  \"plate_no\": \"B 5678 DEF\",\n  \"vehicle_type\": \"CAR\",\n  \"mode\": \"USER\",\n  \"payment_mode\": \"AUTO\",\n  \"spot_id\": \"{{spotId}}\",\n  \"start_at\": \"{{startAt}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "reservations"
              ]
            },
            "description": "User pilih spot spesifik. {{spotId}} harus ter-set dari request sebelumnya atau manual.\n\nKalau spot sudah ke-book (overlap), expect 409 Conflict (EXCLUDE constraint kick in)."
          }
        },
        {
          "name": "Get Reservation by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/reservations/{{reservationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "reservations",
                "{{reservationId}}"
              ]
            },
            "description": "Read reservation by ID. {{reservationId}} ter-populate dari Create."
          }
        },
        {
          "name": "Check In",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('State = CHECKED_IN', () => pm.expect(json.state).to.eql('CHECKED_IN'));",
                  "pm.test('Has checkin_at', () => pm.expect(json.checkin_at).to.be.a('string'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/reservations/{{reservationId}}:checkin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "reservations",
                "{{reservationId}}:checkin"
              ]
            },
            "description": "Driver tiba di parkir, klik check-in. Wajib state = CONFIRMED, dan belum lewat expires_at (1 jam hold).\n\nGagal kalau:\n- State sudah CHECKED_IN/EXPIRED/CANCELLED → 409 Conflict\n- Lewat expires_at → 412 Precondition Failed (RES-011 ErrHoldExpired)"
          }
        },
        {
          "name": "Check Out",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('State = CHECKED_OUT', () => pm.expect(json.state).to.eql('CHECKED_OUT'));",
                  "pm.test('Has checkout_at', () => pm.expect(json.checkout_at).to.be.a('string'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/reservations/{{reservationId}}:checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "reservations",
                "{{reservationId}}:checkout"
              ]
            },
            "description": "Driver pulang, sesi parkir selesai. Trigger billing event (kalau NATS connect).\n\nWajib state = CHECKED_IN."
          }
        },
        {
          "name": "Cancel Reservation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"changed mind\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/reservations/{{reservationId}}:cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "reservations",
                "{{reservationId}}:cancel"
              ]
            },
            "description": "Cancel sebelum check-in. Hanya valid kalau state = CONFIRMED.\n\nSpot kembali tersedia."
          }
        }
      ]
    },
    {
      "name": "Idempotency Tests",
      "description": "Verify idempotency key behavior — same key + same body = same response, NO duplicate insert.",
      "item": [
        {
          "name": "[1/3] Create with Fixed Key",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Pakai fixed key untuk semua 3 request di folder ini",
                  "pm.collectionVariables.set('fixedIdemKey', pm.variables.replaceIn('{{$guid}}'));",
                  "const now = Date.now();",
                  "pm.collectionVariables.set('startAt', new Date(now + 60_000).toISOString());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('idemTestId', json.id);",
                  "console.log('First call → reservation:', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{fixedIdemKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driver_id\": \"driver-idem-test\",\n  \"plate_no\": \"B 0000 IDM\",\n  \"vehicle_type\": \"CAR\",\n  \"mode\": \"SYSTEM\",\n  \"payment_mode\": \"AUTO\",\n  \"start_at\": \"{{startAt}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "reservations"
              ]
            },
            "description": "First call — actual processing, simpan response ke cache."
          }
        },
        {
          "name": "[2/3] Replay (Same Key + Body)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "const expectedId = pm.collectionVariables.get('idemTestId');",
                  "pm.test('Same reservation ID returned (idempotent replay)', () => {",
                  "    pm.expect(json.id).to.eql(expectedId);",
                  "});",
                  "console.log('Replay → same ID:', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{fixedIdemKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driver_id\": \"driver-idem-test\",\n  \"plate_no\": \"B 0000 IDM\",\n  \"vehicle_type\": \"CAR\",\n  \"mode\": \"SYSTEM\",\n  \"payment_mode\": \"AUTO\",\n  \"start_at\": \"{{startAt}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "reservations"
              ]
            },
            "description": "Same key + same body → cached response. Tidak ada DB INSERT baru."
          }
        },
        {
          "name": "[3/3] Conflict (Same Key + Different Body)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 409 Conflict (idempotency_conflict)', () => {",
                  "    pm.expect(pm.response.code).to.eql(409);",
                  "});",
                  "console.log('Conflict status:', pm.response.code, '→ idempotency_conflict expected');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{fixedIdemKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driver_id\": \"DIFFERENT-DRIVER\",\n  \"plate_no\": \"B 9999 ZZZ\",\n  \"vehicle_type\": \"MOTOR\",\n  \"mode\": \"SYSTEM\",\n  \"payment_mode\": \"AUTO\",\n  \"start_at\": \"{{startAt}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "reservations"
              ]
            },
            "description": "Same key tapi body BERBEDA (driver, plate, vehicle_type) — server harus return 409 Conflict.\n\nIni proteksi penting — idempotency-key tidak boleh di-reuse untuk request berbeda."
          }
        }
      ]
    },
