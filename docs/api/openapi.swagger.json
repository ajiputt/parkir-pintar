    "v1AssignmentMode": {
      "type": "string",
      "enum": [
        "ASSIGNMENT_MODE_UNSPECIFIED",
        "SYSTEM",
        "USER"
      ],
      "default": "ASSIGNMENT_MODE_UNSPECIFIED",
      "description": " - SYSTEM: Sistem assign otomatis spot tercepat (default).\n - USER: User pilih spot spesifik (potensi kontensi)."
    },
    "v1BillingMode": {
      "type": "string",
      "enum": [
        "BILLING_MODE_UNSPECIFIED",
        "AUTO",
        "MANUAL"
      ],
      "default": "BILLING_MODE_UNSPECIFIED",
      "description": "BillingMode — payment behavior saat reservation di-finalize.\n\nLihat ADR-0014 (hybrid payment).\n\n - AUTO: AUTO: saldo wallet auto-debit saat invoice ISSUED. No QRIS step.\nCocok untuk driver dengan saldo pre-loaded.\n - MANUAL: MANUAL: driver harus call CreatePayment + scan QRIS. Invoice tetap ISSUED\nsampai webhook Midtrans datang. Bisa OVERDUE kalau driver tidak bayar."
    },
    "v1Channel": {
      "type": "string",
      "enum": [
        "CHANNEL_UNSPECIFIED",
        "CHANNEL_PUSH",
        "CHANNEL_EMAIL",
        "CHANNEL_SMS"
      ],
      "default": "CHANNEL_UNSPECIFIED"
    },
    "v1CountOverdueByDriverResponse": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "v1CreatePaymentRequest": {
      "type": "object",
      "properties": {
        "invoiceId": {
          "type": "string"
        },
        "method": {
          "$ref": "#/definitions/v1PaymentMethod"
        }
      }
    },
    "v1CreateReservationRequest": {
      "type": "object",
      "properties": {
        "driverId": {
          "type": "string"
        },
        "plateNo": {
          "type": "string"
        },
        "vehicleType": {
          "$ref": "#/definitions/v1VehicleType"
        },
        "mode": {
          "$ref": "#/definitions/v1AssignmentMode"
        },
        "spotId": {
          "type": "string",
          "description": "Wajib jika mode = USER (driver pilih spot spesifik).\nUntuk SYSTEM, sistem assign spot kosong dengan floor terendah."
        },
        "startAt": {
          "type": "string",
          "format": "date-time",
          "description": "Expected arrival time. Hold expiry = start_at + holdDuration (default 1h).\nDriver harus check-in sebelum expiry — kalau tidak, reservation auto-cancelled\ndan akan dikenakan no-show penalty 5000 IDR.\nKalau kosong, server pakai now() (booking instant)."
        },
        "paymentMode": {
          "$ref": "#/definitions/v1BillingMode",
          "description": "Payment mode (REQUIRED). AUTO = wallet auto-debit. MANUAL = QRIS scan.\nLihat ADR-0014 untuk hybrid model."
        }
      },
      "title": "---- CreateReservation ----"
    },
    "v1CreateReservationResponse": {
      "type": "object",
      "properties": {
        "reservation": {
          "$ref": "#/definitions/v1Reservation"
        },
        "bookingFee": {
          "$ref": "#/definitions/v1Money",
          "description": "Booking fee yang akan ditagih (5000 IDR, sesuai use case)."
        }
      }
    },
    "v1FloorAvailability": {
      "type": "object",
      "properties": {
        "level": {
          "type": "integer",
          "format": "int32"
        },
        "carAvailable": {
          "type": "integer",
          "format": "int32"
        },
        "carCapacity": {
          "type": "integer",
          "format": "int32"
        },
        "motorAvailable": {
          "type": "integer",
          "format": "int32"
        },
        "motorCapacity": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "v1FloorSpots": {
      "type": "object",
      "properties": {
        "level": {
          "type": "integer",
          "format": "int32"
        },
        "spots": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Spot"
          }
        },
        "capacity": {
          "type": "integer",
          "format": "int32",
          "description": "Convenience metadata untuk UI: count ini bisa beda dari spots.length kalau\nfilter status di-apply (mis. capacity 30 tapi available cuma 5).\n\ntotal spot di floor (untuk vehicle_type kalau filter set)"
        },
        "available": {
          "type": "integer",
          "format": "int32",
          "title": "count yang status=AVAILABLE"
        }
      },
      "description": "FloorSpots — bundled spots untuk satu lantai."
    },
    "v1GetAvailabilityResponse": {
      "type": "object",
      "properties": {
        "parkingAreaId": {
          "type": "string"
        },
        "parkingAreaName": {
          "type": "string"
        },
        "totalCarAvailable": {
          "type": "integer",
          "format": "int32"
        },
        "totalMotorAvailable": {
