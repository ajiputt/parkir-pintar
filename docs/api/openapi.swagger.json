        "HINT_TYPE_EXITED_GEOFENCE",
        "HINT_TYPE_NEAR_PARKING"
      ],
      "default": "HINT_TYPE_UNSPECIFIED"
    },
    "v1Invoice": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "reservationId": {
          "type": "string"
        },
        "driverId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/v1InvoiceStatus"
        },
        "total": {
          "$ref": "#/definitions/v1Money"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1InvoiceItem"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "paidAt": {
          "type": "string",
          "format": "date-time"
        },
        "overdueAt": {
          "type": "string",
          "format": "date-time"
        },
        "paymentMode": {
          "$ref": "#/definitions/v1BillingMode",
          "description": "payment_mode di-forward dari reservation (AUTO atau MANUAL).\nAUTO → payment service auto-charge. MANUAL → driver manual scan QRIS."
        }
      }
    },
    "v1InvoiceItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/v1LineItemType"
        },
        "description": {
          "type": "string"
        },
        "amount": {
          "$ref": "#/definitions/v1Money"
        },
