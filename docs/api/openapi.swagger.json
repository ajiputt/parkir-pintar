        }
      }
    },
    "v1InvoiceStatus": {
      "type": "string",
      "enum": [
        "INVOICE_STATUS_UNSPECIFIED",
        "DRAFT",
        "ISSUED",
        "PAID",
        "VOID",
        "OVERDUE"
      ],
      "default": "INVOICE_STATUS_UNSPECIFIED",
      "description": " - DRAFT: sebelum reservation checkout\n - ISSUED: siap dibayar\n - OVERDUE: OVERDUE — invoice ISSUED tapi driver MANUAL mode tidak bayar dalam grace\nperiod. Lihat ADR-0014. Setelah OVERDUE, driver akan di-block dari booking\nbaru sampai bayar."
    },
