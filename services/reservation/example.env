# Reservation Service — example env template
# Copy ke .env.local lalu sesuaikan. File .env.* di-gitignore (kecuali example.env).
#
# Reservation service handle CreateReservation, CheckIn, CheckOut, Cancel.
# Listen di gRPC (business endpoints) + HTTP (probes & metrics).

# ----- Common -----
APP_ENV=dev                                          # dev | staging | prod
LOG_LEVEL=info                                       # debug | info | warn | error
OTEL_EXPORTER_OTLP_ENDPOINT=                         # kosongkan untuk disable tracing

# ----- Server -----
RESERVATION_GRPC_ADDR=:9091                          # business endpoints
RESERVATION_HTTP_ADDR=:9191                          # /healthz, /readyz, /metrics

# ----- Database (Postgres) -----
# WAJIB — fail-fast kalau ga di-set
DB_URL=postgres://gopark:gopark@postgres:5432/parkirpintar?sslmode=disable&search_path=reservation

# ----- Redis (untuk Redlock spot locking) -----
REDIS_ADDR=redis:6379

# ----- NATS JetStream (event bus) -----
NATS_URL=nats://nats:4222
NATS_STREAM=PARKIRPINTAR

# ----- Cross-service gRPC (optional) -----
# Billing pre-check overdue invoice sebelum allow reservation (ADR-0014).
# Kosongkan = NoopChecker (graceful degradation, ga block driver).
BILLING_GRPC_ADDR_DIAL=billing:9092

# ----- Business tuning -----
# Hold deadline setelah create reservation (sebelum auto-expire)
RESERVATION_HOLD_DURATION=1h
# TTL Redis lock saat acquire spot (anti-double-booking)
SPOT_LOCK_TTL=10s
# Frequency expiry worker scan reservation kadaluwarsa
RESERVATION_EXPIRY_SCAN_INTERVAL=30s
