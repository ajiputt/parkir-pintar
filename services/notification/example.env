# Notification Service — example env template
# Copy ke .env.local lalu sesuaikan. File .env.* di-gitignore (kecuali example.env).
#
# Notification service subscribe NATS events → render template → kirim via SES.
# Tidak expose gRPC business endpoints, cuma HTTP probes.

# ----- Common -----
APP_ENV=dev                                          # dev | staging | prod
LOG_LEVEL=info                                       # debug | info | warn | error
OTEL_EXPORTER_OTLP_ENDPOINT=                         # kosongkan untuk disable tracing

# ----- Server -----
NOTIFICATION_HTTP_ADDR=:9196                         # /healthz, /readyz, /metrics

# ----- Database (Postgres) -----
# WAJIB — fail-fast kalau ga di-set
DB_URL=postgres://gopark:gopark@postgres:5432/parkirpintar?sslmode=disable&search_path=notification

# ----- NATS JetStream (event bus) -----
NATS_URL=nats://nats:4222
NATS_STREAM=PARKIRPINTAR

# ----- AWS SES -----
# Set true untuk mock (no AWS call, log only). Set false dengan AWS creds di prod.
NOTIFICATION_MOCK_SES=true
AWS_REGION=ap-southeast-1
SES_FROM=noreply@parkirpintar.id                     # WAJIB verified di SES (atau sandbox-verified)
SES_REPLY_TO=                                        # optional: reply-to address

# ----- Template -----
# Path ke folder berisi *.tmpl (HTML email templates)
NOTIFICATION_TEMPLATE_DIR=services/notification/templates
