# Billing Service — example env template
# Copy ke .env.local lalu sesuaikan. File .env.* di-gitignore (kecuali example.env).
#
# Billing service subscribe NATS events (reservation/payment) → project ke invoice.
# Expose gRPC BillingService (GetInvoice, GetInvoiceByReservation, dll).

# ----- Common -----
APP_ENV=dev                                          # dev | staging | prod
LOG_LEVEL=info                                       # debug | info | warn | error
OTEL_EXPORTER_OTLP_ENDPOINT=                         # kosongkan untuk disable tracing

# ----- Server -----
BILLING_GRPC_ADDR=:9092                              # gRPC business endpoints
BILLING_HTTP_ADDR=:9192                              # /healthz, /readyz, /metrics

# ----- Database (Postgres) -----
# WAJIB — fail-fast kalau ga di-set
DB_URL=postgres://gopark:gopark@postgres:5432/parkirpintar?sslmode=disable&search_path=billing

# ----- NATS JetStream (event bus) -----
NATS_URL=nats://nats:4222
NATS_STREAM=PARKIRPINTAR

# ----- Overdue worker tuning (ADR-0014) -----
# Frequency scan invoice yang melebihi due_date
BILLING_OVERDUE_INTERVAL=5m
# Grace period sebelum mark invoice sebagai overdue (anti-flap)
BILLING_OVERDUE_GRACE=15m
