# Payment Service — example env template
# Copy ke .env.local lalu sesuaikan. File .env.* di-gitignore (kecuali example.env).
#
# Payment service handle CreatePayment, GetPayment, plus Midtrans webhook.
# Subscribe ke billing events untuk auto-pay flow (ADR-0013).

# ----- Common -----
APP_ENV=dev                                          # dev | staging | prod
LOG_LEVEL=info                                       # debug | info | warn | error
OTEL_EXPORTER_OTLP_ENDPOINT=                         # kosongkan untuk disable tracing

# ----- Server -----
PAYMENT_GRPC_ADDR=:9093                              # gRPC business endpoints
PAYMENT_HTTP_ADDR=:9193                              # /healthz, /readyz, /metrics, /v1/payments/midtrans/notification

# ----- Database (Postgres) -----
# WAJIB — fail-fast kalau ga di-set
DB_URL=postgres://gopark:gopark@postgres:5432/parkirpintar?sslmode=disable&search_path=payment

# ----- NATS JetStream (event bus) -----
NATS_URL=nats://nats:4222
NATS_STREAM=PARKIRPINTAR

# ----- Cross-service gRPC -----
# Billing client untuk lookup invoice + mark paid
BILLING_GRPC_ADDR=billing:9092
# Set true untuk pakai in-memory stub (testing tanpa billing service)
BILLING_STUB=false

# ----- Midtrans (Payment Gateway) -----
# Set true di dev/staging untuk pakai mock (no real Midtrans dial).
# Set false di prod dengan real credentials.
PAYMENT_MOCK_MODE=true
MIDTRANS_SERVER_KEY=SB-Mid-server-CHANGE_ME
MIDTRANS_CLIENT_KEY=SB-Mid-client-CHANGE_ME
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com

# ----- Auto-pay (ADR-0013) -----
# Set true untuk auto-mark invoice PAID saat payment SUCCEEDED event (skip user click).
# Berguna untuk demo flow tanpa real Midtrans webhook callback.
PAYMENT_AUTO_PAY=false
