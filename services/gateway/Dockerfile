# syntax=docker/dockerfile:1.6

# ---------- Stage 1: Proto generation ----------
FROM golang:1.26.3-alpine AS proto-gen
WORKDIR /src
RUN apk add --no-cache git
RUN go install github.com/bufbuild/buf/cmd/buf@v1.34.0
COPY proto ./proto
RUN mkdir -p /src/docs/api
WORKDIR /src/proto
RUN buf generate
RUN test -d /src/proto/gen/common/v1 || (echo "ERROR: buf generate failed" && ls -la /src/proto/gen/ 2>/dev/null && exit 1) \
 && echo "✓ Proto generation successful"

# ---------- Stage 2: Build service binary ----------
FROM golang:1.26.3-alpine AS build
WORKDIR /src
# Module mode (no go.work) — replace directives di go.mod handle pkg + proto.
COPY pkg ./pkg
COPY --from=proto-gen /src/proto ./proto
# Copy OpenAPI spec (generated by buf di proto-gen stage) untuk dipakai Swagger UI.
COPY --from=proto-gen /src/docs ./docs
COPY services/gateway ./services/gateway
WORKDIR /src/services/gateway
RUN apk add --no-cache git \
 && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/gateway ./cmd

# ---------- Stage 3: Runtime ----------
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/gateway /gateway
# Embed OpenAPI spec biar Swagger UI di /docs bisa serve real spec
# (bukan fallback placeholder). Path: /docs/api/openapi.swagger.json.
COPY --from=build /src/docs /docs
ENV OPENAPI_SPEC_PATH=/docs/api/openapi.swagger.json
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/gateway"]
