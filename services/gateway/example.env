# Gateway Service — example env template
# Copy ke .env.local lalu sesuaikan. File .env.* di-gitignore (kecuali example.env).
#
# Gateway adalah entry point HTTP REST → di-translate ke gRPC ke backend services.
# Wajib di-set: backend service addrs, JWT secret, rate limit config.

# ----- Common -----
APP_ENV=dev                                          # dev | staging | prod
LOG_LEVEL=info                                       # debug | info | warn | error
OTEL_EXPORTER_OTLP_ENDPOINT=                         # kosongkan untuk disable tracing

# ----- Server -----
GATEWAY_HTTP_PORT=8080                               # public HTTP entry point

# ----- Backend gRPC dial addresses -----
RESERVATION_GRPC_ADDR_DIAL=reservation:9091
BILLING_GRPC_ADDR_DIAL=billing:9092
PAYMENT_GRPC_ADDR_DIAL=payment:9093
PAYMENT_HTTP_URL=http://payment:9193                 # untuk REST callback (Midtrans)

# ----- Auth (JWT) -----
JWT_SECRET=demo-secret-change-me-in-production       # WAJIB ganti di prod (≥32 chars)
JWT_ISSUER=parkirpintar
JWT_TTL=1h                                           # token lifetime
AUTH_PASSTHROUGH_NO_TOKEN=false                      # strict mode: false di prod
DEV_TOKEN_SECRET=                                    # gate untuk /dev/token endpoint (set di non-prod only)

# ----- Rate Limit (per IP, per endpoint tier) -----
# Light = read endpoints (availability, get reservation)
GATEWAY_RATELIMIT_LIGHT_RPS=100
GATEWAY_RATELIMIT_LIGHT_BURST=200
# Medium = standard write (create reservation)
GATEWAY_RATELIMIT_MEDIUM_RPS=20
GATEWAY_RATELIMIT_MEDIUM_BURST=40
# Heavy = expensive ops (payment, multi-step)
GATEWAY_RATELIMIT_HEAVY_RPS=5
GATEWAY_RATELIMIT_HEAVY_BURST=10
# Webhook = inbound dari payment gateway (Midtrans)
GATEWAY_RATELIMIT_WEBHOOK_RPS=50
GATEWAY_RATELIMIT_WEBHOOK_BURST=100
# Default fallback
GATEWAY_RATELIMIT_DEFAULT_RPS=10
GATEWAY_RATELIMIT_DEFAULT_BURST=20

# ----- Redis (untuk rate limit distributed counter) -----
GATEWAY_REDIS_ADDR=redis:6379
